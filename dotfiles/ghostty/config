# This binds Control + Enter to toggle or open a new Ghostty window globally

keybind = global:ctrl+enter=new_window
theme = One Half Dark
cursor-style = block
shell-integration-features = no-cursor

# Horizontal padding (left and right)

window-padding-x = 5

# Vertical padding (top and bottom)

window-padding-y = 5

# Optional: Balance padding ensures the content area remains

# perfectly centered even if font sizes change.

window-padding-balance = true

# Sets transparency level (0.0 is invisible, 1.0 is solid).

# 0.8 to 0.9 is usually a good readable "glass" look.

background-opacity = 0.85

# Optional: Adds a blur effect (frosted glass) behind the text.

# Useful to keep text readable against busy wallpapers.

# Note: This relies on your Linux compositor (KWin on KDE) supporting blur.

background-blur-radius = 20
shell-integration-features = ssh-terminfo,ssh-env
macos-option-as-alt = right
