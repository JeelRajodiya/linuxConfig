// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "cli_default_open_behavior": "new_window",
  "buffer_font_weight": 400.0,
  "ui_font_family": ".ZedSans",
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "agent_buffer_font_size": 13.0,
  "agent_ui_font_size": 14.0,
  "buffer_line_height": "comfortable",
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "fast-mode": true,
        "mode": "agent",
        "model": "gpt-5.6-terra",
        "reasoning_effort": "medium"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "ollama": {
      "model": "gemma4:e4b",
      "api_url": "http://localhost:11434",
      "prompt_format": "infer"
    },
    "mode": "subtle",
    "provider": "copilot",
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 14.0,
    "font_family": "JetBrainsMonoNL Nerd Font Propo",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "VSCode",
  "agent": {
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gemini-3.1-pro-preview",
      "enable_thinking": false
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "gemini-3.5-flash",
      "enable_thinking": true,
      "effort": "MEDIUM"
    },
    "sidebar_side": "right",
    "dock": "right",
    "enabled": true,
    "button": true,
    "model_parameters": [],
  },
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 2.0,
  "gutter": {
    "line_numbers": true,
  },
  "cursor_blink": true,
  "autosave": "on_focus_change",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "linked_edits": true,
  "show_whitespaces": "all",
  "show_edit_predictions": true,
  "hard_tabs": false,
  "tab_size": 4,
  "languages": {
    "Rust": {
      "show_edit_predictions": true,
      "tab_size": 2,
    },
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,

  "dap": {
    "CodeLLDB": {
      "binary": "/Library/Developer/CommandLineTools/usr/bin/lldb-dap",
    },
  },

  "lsp": {
    "thrift-ls": {
      "binary": {
        "path": "/Users/zeelrajodiya/go/bin/thrift-ls",
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "procMacro": {
          "enable": true,
        },
        "cargo": {
          "buildScripts": {
            "enable": true,
          },
        },
      },
    },
  },

  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
}
